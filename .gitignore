# ==============================================================================
# Syone Enterprise GenAI Formation - Git Ignore Rules
# ==============================================================================

# Python Environments & Bytecode
.venv/
env/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node / Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/.turbo/
frontend/build/
frontend/out/
frontend/*.tsbuildinfo
frontend/.npm
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Environment & Secrets (Keep .env.example, ignore active .env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Large Model Weights & Transformer Caches (Downloadable via scripts/download_models.py)
models/huggingface/*
!models/huggingface/.gitkeep
models/docling/*
!models/docling/.gitkeep
models/fastembed/*
!models/fastembed/.gitkeep
models/torch/*
!models/torch/.gitkeep
models/sentence_transformers/*
!models/sentence_transformers/.gitkeep

# ==============================================================================
# Data Directories — Generated at Runtime (NOT committed to git)
# Run the scripts in order to regenerate each stage:
# ==============================================================================

# Stage 1: raw source data IS committed (small, and a fresh clone must work offline):
#   data/raw_syone_corp/        dated snapshot of a real scrape (re-run scripts/scrape_syone.py to refresh)
#   data/raw_hardware_manuals/  the 8 synthetic Aurora manuals (PDF)
#   data/extracted_images/      informative Syone images + the 9 Aurora figures + captions
# Stages 2 and 3 are regenerated by the pipeline (cheap) and are not committed.
data/docling_output/*
!data/docling_output/.gitkeep
data/okf_store/*
!data/okf_store/.gitkeep
notebooks/_executed/
docs/screenshots/*.yml
docs/screenshots/*.log
.playwright-cli/

# Persistent Database Volumes & Runtime State
neo4j_data/
qdrant_data/
langfuse_db_data/
*.log
*.sqlite3

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Browser automation scratch
.playwright-cli/

# Syone-internal material (slide decks, agenda, goals, templates): kept locally, never published
Documents/
# The speaker guides, if a copy ever lands at the root
/SPEAKER_GUIDE_*.md
/FORMATION_SPEAKER_GUIDE.md
