# ==============================================================================
# Syone Enterprise GenAI Formation - Environment Configuration
# Copy to .env (cp .env.example .env). After any change: docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model provider keys: put YOUR key(s) here
# ------------------------------------------------------------------------------
# The gateway (config/litellm_config.yaml) tries providers in order and fails over on limits and outages.
# One key is enough. Recommended to start: OpenRouter (free account, no credit card): https://openrouter.ai/keys
#   Free models: 20 requests/minute and 50 requests/day (1,000/day once the account holds $10 of credit).
#   One question in the console uses about 5-9 requests (both tracks; the agent makes one per step).
OPENROUTER_API_KEY=
# OpenCode Zen: pay-as-you-go balance (what the speaker uses; default model deepseek-v4.1-flash).
#   OpenCode's FREE models and its Go plan cannot be used through an API: see docs/AI_GATEWAY_FAILOVER.md.
OPENCODE_API_KEY=
# Other providers with a free API tier: uncomment their block in config/litellm_config.yaml and set the key.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# No key at all? Run LM Studio or Ollama and pick the alias `formation-local`, or use "extractive mode"
# (the retrieved passages, no generated answer). The retrieval evaluation needs no LLM at all.

# Optional: keep the keys in a file OUTSIDE this folder, so they never show when you open .env on a shared screen.
# Same KEY=value format. Keys in that file win over the lines above. Leave this unset to use the lines above.
# SECRETS_FILE=${HOME}/.config/syone-formation/secrets.env

# ------------------------------------------------------------------------------
# 2. The AI gateway (LiteLLM)
# ------------------------------------------------------------------------------
# Admin key of the gateway; the backend, the notebooks and Prometheus use it to call the gateway.
# Every port is bound to 127.0.0.1 (only this machine), so the demo default is fine on your laptop.
# Sharing the gateway on a LAN? Change this key first (it can mint and delete keys), then set GATEWAY_BIND=0.0.0.0.
LITELLM_MASTER_KEY=sk-syone-formation-master-key
# GATEWAY_BIND=0.0.0.0
# Using a speaker's shared gateway instead: put the virtual key you were given in LITELLM_MASTER_KEY, and
# LITELLM_URL=http://<speaker-ip>:14000/v1

# ------------------------------------------------------------------------------
# 3. Databases and observability (demo defaults; same login everywhere: syone / syone2026)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=syone2026

QDRANT_HOST=localhost
QDRANT_PORT=16333

LANGFUSE_PUBLIC_KEY=pk-lf-syone-public-key
LANGFUSE_SECRET_KEY=sk-lf-syone-secret-key
LANGFUSE_HOST=http://localhost:13000
NEXTAUTH_SECRET=syonesecret1234567890abcdef

# Opik Observability (optional Comet ML integration)
OPIK_API_KEY=
OPIK_WORKSPACE=default

# Workspace local cache paths (all models download into ./models)
HF_HOME=./models/huggingface
TORCH_HOME=./models/torch
SENTENCE_TRANSFORMERS_HOME=./models/sentence_transformers
DOCLING_CACHE_DIR=./models/docling

# Service endpoints for the frontend
NEXT_PUBLIC_API_URL=http://localhost:18000
NEXT_PUBLIC_NEO4J_URL=http://localhost:17474
NEXT_PUBLIC_LANGFUSE_URL=http://localhost:13000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:13001
NEXT_PUBLIC_LITELLM_URL=http://localhost:14000
NEXT_PUBLIC_QDRANT_URL=http://localhost:16333
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:19090
NEXT_PUBLIC_JUPYTER_URL=http://localhost:18888
